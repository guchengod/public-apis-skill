{
  "schema_version": 2,
  "id": "email/contactlint",
  "name": "ContactLint",
  "category": "Email",
  "description": "Validate email syntax, MX, disposable and role addresses with typo suggestions, plus phone numbers",
  "documentation_url": "https://contactlint.com/",
  "auth": {
    "type": "apiKey",
    "required": true,
    "strategy": "configurable",
    "header": null,
    "credential_env": "PUBLIC_API__EMAIL__CONTACTLINT__API_KEY"
  },
  "transport": {
    "https": "yes",
    "cors": "yes"
  },
  "request": {
    "base_url": null,
    "default_method": "GET"
  },
